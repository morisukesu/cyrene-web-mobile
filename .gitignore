cyrene_mobile/plugins/
cyrene_mobile/plugins_inbox/
cyrene_mobile/_plugin_tmp/

# 本地快照 / 备份
*.bak
*.pre_*
*.tmp

# 下载与后台任务产物
downloads/
shell_jobs/

# 系统垃圾
.DS_Store
Thumbs.db

# 更新脚本留下的代码备份
cyrene_mobile.bak-*/
